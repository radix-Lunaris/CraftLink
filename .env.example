# Shared deployment configuration. Copy once; migrate existing deployments first.
# Use literal single quotes for passwords containing $, #, spaces or double quotes.
MCLINK_DB_HOST=web-mysql80
MCLINK_DB_PORT=3306
MCLINK_DB_NAME=mclink
MCLINK_DB_USER=mclink
MCLINK_DB_PASSWORD=__CHANGE_ME__
MCLINK_ADMIN_API_TOKEN=__CHANGE_ME__
MCLINK_RELAY_API_URL=http://mc-relay:19101
MCLINK_DOCKER_NETWORK=1panel-network
MCLINK_RELAY_CONTAINER=mc-relay
MCLINK_PANEL_CONTAINER=mc-panel
MCLINK_STATUS_VOLUME=mc-link-status
MCLINK_RELAY_PUBLIC_PORT=19100
MCLINK_PANEL_BIND=127.0.0.1
MCLINK_PANEL_PORT=19102
MCLINK_PANEL_TITLE='CraftLink 管理面板'
MCLINK_PANEL_ICP=''
MCLINK_PANEL_COPYRIGHT=''
# MCLINK_HOME and MCLINK_ENV_FILE are optional process-level path overrides.
# Client overrides use its existing per-user mclink_config.json; update_url is HTTPS.
