# ============================================================================
#  MC-Link / CraftLink —— 真实凭据模板
# ============================================================================
#
#  用法（在服务器上执行一次）：
#
#      cp .env.example /opt/mc-link/.env
#      python3 /opt/mc-link/scripts/rotate_secrets.py      # 生成随机值并写回
#      # 或者：手工把下面的值填成你自己的
#
#  为什么凭据不再写在 docker-compose.yml 里：
#    v3.9.15 及以前，MCLINK_DB_PASSWORD 与 MCLINK_ADMIN_API_TOKEN 是**明文
#    写进交付包**的。这个 zip 只要外传一次（例如拿去给别人排查），数据库与
#    管理 API 就一起交出去了。
#
#    v3.9.16 起 compose 里只有 `${MCLINK_DB_PASSWORD:?...}` 这样的引用：
#    变量没设置时 docker compose **拒绝启动**并打出这里的提示，而 rebuild.sh
#    会先一步拦住并说人话。真实值只存在于服务器的 .env 里，不进包、不进仓库。
#
#  这个文件本身**只含占位符**，永远不要把它改名成 .env 直接使用。
# ============================================================================

# ---- 数据库（MySQL）----
# 改这里的值之后，MySQL 里的账号密码也要跟着改（rotate_secrets.py 会打印 SQL）。
MCLINK_DB_HOST=web-mysql80
MCLINK_DB_PORT=3306
MCLINK_DB_NAME=mclink
MCLINK_DB_USER=mclink
MCLINK_DB_PASSWORD=CHANGE_ME_REDACTED
# ---- 管理 API（PHP 面板 -> 中继，19101）----
# 面板与中继必须是同一个值，否则面板上显示「无法从中继读取开关状态」。
MCLINK_ADMIN_API_TOKEN=CHANGE_ME_REDACTED